# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/interview_platform?schema=public"

# Clerk backend secret (https://dashboard.clerk.com → API Keys)
CLERK_SECRET_KEY="sk_test_your-clerk-secret"

# --- Language model -----------------------------------------------------------
# Any OpenAI-compatible Chat Completions API works.
#
# Hosted OpenAI (default):
OPENAI_API_KEY="sk-your-openai-key"
# AI_MODEL="gpt-4o-mini"
#
# Free / local alternative, e.g. Ollama (https://ollama.com):
#   ollama pull llama3.1
# OPENAI_BASE_URL="http://localhost:11434/v1"
# AI_MODEL="llama3.1"
# (OPENAI_API_KEY is not needed when OPENAI_BASE_URL is set.)

# --- Server -------------------------------------------------------------------
PORT=3001
# Origin of the frontend. Required when NODE_ENV=production (CORS + token audience).
FRONTEND_URL="http://localhost:3000"
NODE_ENV=development
